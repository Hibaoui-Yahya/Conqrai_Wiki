# ConqrPlan MCP service - example configuration. Placeholders only.
#
# owner=deployment   scope=per-environment   source=platform env
CONQRPLAN_API_URL=https://conqrplan.example.com/api/v1
PORT=8080
CONQRPLAN_REQUEST_TIMEOUT_MS=30000
CONQRPLAN_MAX_CONCURRENCY=16
CONQRPLAN_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info
CONQRPLAN_SERVICE_NAME=conqrplan-mcp

# owner=organization scope=per-tenant       source=static JSON or Hub provider
# orgUid must be the canonical suite identifier already provisioned in
# ConqrPlan. Regenerating it breaks every existing identity mapping.
CONQRPLAN_TENANTS=[{"orgUid":"conqr:org:REPLACE-WITH-WORKSPACE-UUID","workspaceSlug":"REPLACE","allowedProjectIds":null}]

# owner=secrets      scope=per-environment  source=secret manager
# Bot token. Transport identity only; never becomes a human actor.
CONQRPLAN_API_KEY=REPLACE_WITH_BOT_TOKEN
# This service's OWN Ed25519 private key (PKCS#8 PEM). ConqrPlan registers
# only the public half. It never receives ConqrPlan's HMAC key: a shared
# secret would make this service able to mint anything ConqrPlan accepts.
#   openssl genpkey -algorithm ed25519 -out mcp.key
#   openssl pkey -in mcp.key -pubout -out mcp.pub
CONQRPLAN_MCP_PRIVATE_KEY_PEM=REPLACE_WITH_PKCS8_PEM
CONQRPLAN_MCP_KEY_ID=mcp-YYYY-MM
CONQRPLAN_MCP_ISSUER=conqrplan-mcp
CONQR_OBO_AUDIENCE=conqrplan
# Issuers whose assertions this service accepts. Algorithm is pinned per
# issuer, so a token cannot choose its own. publicKeys is kid -> SPKI PEM.
CONQRPLAN_MCP_INBOUND_ISSUERS={"conqrhub":{"issuer":"conqrhub","algorithm":"EdDSA","publicKeys":{"hub-YYYY-MM":"REPLACE_WITH_SPKI_PEM"},"maxTtlSeconds":300}}
# sha256 hex digests of accepted client bearer tokens, comma separated.
CONQRPLAN_MCP_CLIENT_TOKEN_SHA256=REPLACE_WITH_SHA256_HEX
